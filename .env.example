# Variables de entorno para producción (Vercel)
# Copia este archivo como .env para desarrollo local

# Base de datos PostgreSQL (requerido en producción)
# Puedes usar Supabase, Neon, o cualquier PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Clave secreta para sesiones Flask (genera una cadena aleatoria segura)
SECRET_KEY=tu-clave-secreta-muy-segura

# Email para reportes de administración (opcional)
MAIL_ADMIN_REPORT_TO=admin@example.com

# Configuración de correo (opcional, para Flask-Mail)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-password
